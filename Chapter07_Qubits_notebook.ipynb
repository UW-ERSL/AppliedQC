    "np.set_printoptions(precision=4, suppress=True)\n",
    "\n",
    "def separability(psi):\n",
    "    \"\"\"A 2-qubit state is a product state iff x0*x3 - x1*x2 == 0 (Section 7.8).\"\"\"\n",
    "    x0, x1, x2, x3 = psi.data\n",
    "    return x0*x3 - x1*x2\n",
    "\n",
    "states = {\n",
    "  \"1/2|00> + i/2|01> - 1/2|10> - i/2|11>   (book: product) \":\n",
    "      Statevector([1/2, 1j/2, -1/2, -1j/2]),\n",
    "  \"1/2|00> + i/sqrt2|10> + (sqrt3+i)/4|11> (book: entangled)\":\n",
    "      Statevector([1/2, 0, 1j/np.sqrt(2), (np.sqrt(3)+1j)/4]),\n",
    "  \"Bell |phi+> = (|00>+|11>)/sqrt2                          \":\n",
    "      Statevector([1/np.sqrt(2), 0, 0, 1/np.sqrt(2)]),\n",
    "  \"Bell |phi-> = (|00>-|11>)/sqrt2                          \":\n",
    "      Statevector([1/np.sqrt(2), 0, 0, -1/np.sqrt(2)]),\n",
    "  \"Bell |psi+> = (|01>+|10>)/sqrt2                          \":\n",
    "      Statevector([0, 1/np.sqrt(2), 1/np.sqrt(2), 0]),\n",
    "  \"Bell |psi-> = (|01>-|10>)/sqrt2                          \":\n",
    "      Statevector([0, 1/np.sqrt(2), -1/np.sqrt(2), 0]),\n",
    "}\n",
    "for name, sv in states.items():\n",
    "    d = separability(sv)\n",
    "    print(f\"{name}  valid={sv.is_valid()}  x0x3-x1x2 = {d:+.4f}  ->  \"\n",
    "          f\"{'PRODUCT' if np.isclose(d, 0) else 'ENTANGLED'}\")\n",
    "\n",
    "# --- the product state really does factor ---------------------------------\n",
    "psi = Statevector([1/2, 1j/2, -1/2, -1j/2])\n",
    "q1 = Statevector([1/np.sqrt(2), -1/np.sqrt(2)])      # (|0> - |1>)/sqrt2\n",
    "q0 = Statevector([1/np.sqrt(2), 1j/np.sqrt(2)])      # (|0> + i|1>)/sqrt2\n",
    "print(\"\\n|q1> (x) |q0> reproduces the product state?\",\n",
    "      np.allclose(q1.tensor(q0).data, psi.data))\n",
    "\n",
    "# --- entanglement is what makes partial measurement informative ------------\n",
    "bell = Statevector([1/np.sqrt(2), 0, 0, 1/np.sqrt(2)]); bell.seed(0)\n",
    "print(\"\\nBell state: measuring the LEFT qubit alone determines the RIGHT one -\")\n",
    "for _ in range(4):\n",
    "    out, post = bell.measure(qargs=[1])\n",
    "    print(f\"   left -> {out}   whole system collapses to\",\n",
    "          {str(k): np.round(v, 3) for k, v in post.to_dict().items()})"
