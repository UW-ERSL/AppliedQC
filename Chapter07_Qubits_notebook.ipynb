   "source": [
    "np.set_printoptions(precision=4, suppress=True)\n",
    "ket0, ket1 = Statevector.from_label('0'), Statevector.from_label('1')\n",
    "\n",
    "def outer(a, b):                       # |a><b| ;  (|a><b|)_ij = x_i y_j*\n",
    "    return np.outer(a.data, b.data.conj())\n",
    "\n",
    "P0, P1 = outer(ket0, ket0), outer(ket1, ket1)\n",
    "print(\"|0><0| =\\n\", P0, \"\\n|1><1| =\\n\", P1)\n",
    "print(\"Hermitian?\", np.allclose(P0, P0.conj().T), np.allclose(P1, P1.conj().T))\n",
    "print(\"idempotent (P^2 = P)?\", np.allclose(P0 @ P0, P0), np.allclose(P1 @ P1, P1))\n",
    "print(\"P0 + P1 = I ?\", np.allclose(P0 + P1, np.eye(2)))\n",
    "\n",
    "# --- Born rule in projector form:  P(0) = <q| (|0><0|) |q> = |<0|q>|^2 -----\n",
    "def prob_via_projector(q, P):\n",
    "    return np.real(q.data.conj() @ P @ q.data)\n",
    "\n",
    "q = Statevector([(1+1j)/2, -1/np.sqrt(2)])          # book Section 7.2 / 7.6 example\n",
    "print(\"\\n|q> = (1+i)/2|0> - 1/sqrt(2)|1>\")\n",
    "print(\"  <q|(|0><0|)|q> =\", round(prob_via_projector(q, P0), 4),\n",
    "      \"|  |<0|q>|^2 =\", round(abs(ket0.inner(q))**2, 4),\n",
    "      \"|  |x|^2 =\", round(abs(q.data[0])**2, 4), \"   book: 1/2\")\n",
    "\n",
    "q = Statevector([np.sqrt(3)/2, 1/2])                # book exercise\n",
    "print(\"\\n|q> = sqrt(3)/2|0> + 1/2|1>\")\n",
    "print(\"  P(1) = <q|(|1><1|)|q> =\", round(prob_via_projector(q, P1), 4), \"   book: 1/4\")\n",
    "\n",
    "# --- exercise:  |+><+| ----------------------------------------------------\n",
    "plus = Statevector([1/np.sqrt(2), 1/np.sqrt(2)])\n",
    "Pp = outer(plus, plus)\n",
    "print(\"\\n|+><+| =\\n\", Pp)\n",
    "print(\"Hermitian?\", np.allclose(Pp, Pp.conj().T), \"| idempotent?\", np.allclose(Pp @ Pp, Pp))"
   ]
