   "source": [
    "import collections\n",
    "np.set_printoptions(precision=4, suppress=True)\n",
    "def pdict(sv):                                  # tidy printing of probabilities_dict()\n",
    "    return {str(k): round(float(v), 4) for k, v in sv.probabilities_dict().items()}\n",
    "\n",
    "# --- Born rule, single qubit:  |q> = sqrt(3)/2 |0> + 1/2 |1>  ->  75% / 25% -\n",
    "q = Statevector([np.sqrt(3)/2, 1/2]); q.seed(1)\n",
    "print(\"|q> probabilities :\", pdict(q), \"      book: 75% / 25%\")\n",
    "print(\"10000 shots       :\", {str(k): int(v) for k, v in q.sample_counts(10000).items()})\n",
    "print(\"a single read     :\", str(q.measure()[0]))\n",
    "\n",
    "# --- global phase is invisible to measurement -------------------------------\n",
    "q2 = Statevector([1j*np.sqrt(3)/2, -1/2])       # book: i.sqrt(3)/2 |0> - 1/2 |1>\n",
    "print(\"\\n|q2> probabilities:\", pdict(q2))\n",
    "print(\"identical probabilities?\", pdict(q) == pdict(q2),\n",
    "      \"|  identical states?\", np.allclose(q.data, q2.data),\n",
    "      \" <- measurement cannot tell them apart\")\n",
    "\n",
    "# --- Born rule, multi-qubit: the worked example of Section 7.2 --------------\n",
    "#     |psi> = 1/2|00> + i/sqrt(2)|10> + (sqrt(3)+i)/4|11>\n",
    "psi = Statevector([1/2, 0, 1j/np.sqrt(2), (np.sqrt(3)+1j)/4])   # |00>,|01>,|10>,|11>\n",
    "print(\"\\n|psi> is a valid qubit system?\", psi.is_valid())\n",
    "print(\"both qubits measured:\", pdict(psi), \"   book: 1/4, 1/2, 1/4\")\n",
    "\n",
    "# --- partial measurement ----------------------------------------------------\n",
    "# Qiskit is little-endian: qargs=[1] is the LEFT (most significant) qubit,\n",
    "#                          qargs=[0] is the RIGHT (least significant) qubit.\n",
    "book = {(1, '0'): {'00': 1},\n",
    "        (1, '1'): {'10': 1j/np.sqrt(2)/np.sqrt(3/4), '11': (np.sqrt(3)+1j)/4/np.sqrt(3/4)},\n",
    "        (0, '0'): {'00': 0.5/np.sqrt(3/4),           '10': 1j/np.sqrt(2)/np.sqrt(3/4)},\n",
